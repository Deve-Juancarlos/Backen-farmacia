# Puerto del servidor
PORT=3000

# Base de datos MySQL
DB_NAME=farmacia
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DIALECT=mysql

# Secreto para firmar los JWT (usar uno largo y aleatorio en producción)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Orígenes permitidos por CORS, separados por coma. Ej: http://localhost:5173,https://miapp.com
CORS_ORIGIN=http://localhost:5173

# Solo desarrollo: true aplica cambios de esquema sin borrar datos. Nunca en producción.
DB_SYNC_ALTER=false
